<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_BibliotecaPersonal.Views.LibraryPage"
             Title="Mi Biblioteca"
             BackgroundColor="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="Auto, *">

        <SearchBar Grid.Row="0" 
                   Placeholder="Buscar por título o autor..." 
                   Margin="10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Books}" Margin="10,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                    <Label Text="📚" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="Tu biblioteca está vacía" Style="{StaticResource TitleStyle}" HorizontalTextAlignment="Center"/>
                    <Button Text="Agregar mi primer libro" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddBookCommand}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">

                            <Image Grid.Column="0" Source="{Binding CoverUrl}" Aspect="AspectFill" HeightRequest="110" WidthRequest="80" BackgroundColor="{DynamicResource Gray300}"/>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource SubtitleStyle}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                <Label Text="{Binding Author}" TextColor="{DynamicResource TextColor}"/>
                                <Label Text="{Binding Genre}" Style="{StaticResource CaptionStyle}"/>

                                <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                    <Label Text="⭐" IsVisible="{Binding IsRead}"/>
                                    <Label Text="Leído" Style="{StaticResource CaptionStyle}" TextColor="Green" IsVisible="{Binding IsRead}"/>
                                    <Label Text="Pendiente" Style="{StaticResource CaptionStyle}" TextColor="Orange" IsVisible="{Binding IsRead}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="Ver" Style="{StaticResource SecondaryButtonStyle}" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>