<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProyectoFinal_BibliotecaPersonal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProyectoFinal_BibliotecaPersonal.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Mi Biblioteca Personal"
    BackgroundColor="{DynamicResource PrimaryColor}">

    <FlyoutItem Title="Mi Biblioteca" Icon="library.png">
        <ShellContent Route="library" ContentTemplate="{DataTemplate views:LibraryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Buscar Libros" Icon="search.png">
        <ShellContent Route="search" ContentTemplate="{DataTemplate views:SearchPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Estadísticas" Icon="stats.png">
        <ShellContent Route="statistics" ContentTemplate="{DataTemplate views:StatisticsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Agregar Libro" Icon="add.png">
        <ShellContent Route="addbook" ContentTemplate="{DataTemplate views:AddBookPage}" />
    </FlyoutItem>

</Shell>